# ============================================
# KratDesk .gitignore
# ============================================

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
.output/
.vinxi/
.tanstack/
.nitro/
coverage/
.cache/

# Local files
*.local

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.sample
.dev.vars

# Private keys and certificates
*.pem
*.key
*.pfx
*.p12
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub

# Database files and backups
*.sqlite
*.sqlite3
*.db
*.dump
*.backup

# Ignore SQL files by default
*.sql

# Keep KratDesk Drizzle database migrations
!drizzle/migrations/**/*.sql

# Application uploads and local data
uploads/
data/
backups/

# Wrangler / Cloudflare
.wrangler/

# Temporary files
tmp/
temp/

# Windows
Thumbs.db
Desktop.ini

# macOS
.DS_Store

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?